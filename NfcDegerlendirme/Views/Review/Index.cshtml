@model ReviewVm
@{ ViewData["Title"] = Model.BusinessName; }
<div class="stage" style="--p:@Model.PrimaryColor">
<main class="panelcard" id="app" data-code="@Model.Code" data-required="@(Model.CommentRequired ? "true" : "false")">
  @if (!string.IsNullOrEmpty(Model.CoverUrl)) { <img class="cover" src="@Model.CoverUrl" alt=""> }
  <div class="head">
    @if (!string.IsNullOrEmpty(Model.LogoUrl)) { <img src="@Model.LogoUrl" alt="@Model.BusinessName"> }
    <h1>@Model.BusinessName</h1><p class="sub">Deneyiminizi değerlendirin</p>
  </div>

  <form id="form" class="fade" novalidate>
    <div class="stars" id="stars" role="radiogroup" aria-label="Puan">
      @for (var i = 1; i <= 5; i++) {
        <button type="button" class="star" role="radio" aria-checked="false" aria-label="@(i) yıldız"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.1 6.6 7.2.9-5.3 5 1.4 7.2L12 18l-6.4 3.7L7 14.5 1.7 9.5l7.2-.9z"/></svg></button>
      }
    </div>
    <p class="rlabel" id="rlabel" aria-live="polite"></p>
    <div class="field"><textarea id="comment" rows="4" maxlength="1500" placeholder=" "></textarea><label for="comment">@(Model.CommentRequired ? "Yorumunuz (zorunlu)" : "Yorumunuz")</label></div>
    <small class="hint" id="counter">0/1500</small>
    <div class="field"><input id="name" maxlength="80" placeholder=" " autocomplete="name"><label for="name">Adınız (isteğe bağlı)</label></div>
    <div class="field"><input id="email" type="email" maxlength="120" placeholder=" " autocomplete="email"><label for="email">E-posta (isteğe bağlı)</label></div>
    <p role="alert" class="err" id="err"></p>
    <button class="btn" type="submit">Devam</button>
    @if (!string.IsNullOrEmpty(Model.KvkkUrl)) { <p class="legal"><a href="@Model.KvkkUrl">KVKK Aydınlatma Metni</a></p> }
  </form>

  <section id="preview" class="fade" hidden>
    <h2 class="center">Göndermeden önce kontrol edin</h2>
    <div class="pv-stars" id="pvStars" aria-live="polite"></div>
    <p class="rlabel" id="pvLabel"></p>
    <blockquote id="pvComment" hidden></blockquote>
    <p role="alert" class="err" id="pvErr"></p>
    <button class="btn" id="sendBtn" type="button">Onayla ve gönder</button>
    <button class="btn alt" id="editBtn" type="button">Düzenle</button>
  </section>

  <section id="done" class="fade done" role="status" hidden>
    <div class="check"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
    <h2>Teşekkürler</h2><p class="sub">Değerlendirmeniz kaydedildi.</p>
    <div id="googleBox" hidden>
      <p class="sub" style="margin-top:16px">Google'da da paylaşmak isterseniz birkaç saniye içinde Google sayfasına yönlendirileceksiniz. Yorumunuz Google'a otomatik gönderilmez; orada kendi hesabınızla yazmanız gerekir.</p>
      <button type="button" class="btn copy" id="copyBtn" hidden>
        <svg class="i-copy" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 9h10v11H9zM5 15V4h10"/></svg>
        <svg class="i-ok" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        <span id="copyTxt">Yorumumu kopyala</span></button>
      <a class="btn" id="googleLink" href="#" rel="noopener noreferrer">Google'a git</a>
    </div>
    <p class="sub" id="missing" style="margin-top:16px" hidden>Bu işletme için Google bağlantısı tanımlı değil; değerlendirmeniz yine de kaydedildi.</p>
  </section>
</main>
</div>
@section Scripts { <script src="~/js/review.js" asp-append-version="true"></script> }
