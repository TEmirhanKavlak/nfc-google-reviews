@model AdminVm
@{ ViewData["Title"] = "Firmalar"; }
<div class="dash">
  <div class="topbar"><b>Süper admin</b><form method="post" asp-antiforgery="true" action="/cikis"><button class="btn alt sm">Çıkış</button></form></div>
  @if (TempData["Ok"] != null) { <p role="status" class="ok" style="word-break:break-all">@TempData["Ok"]</p> }
  @if (TempData["Err"] != null) { <p role="alert" class="err">@TempData["Err"]</p> }
  <h2>Yeni firma ekle</h2>
  <form method="post" asp-action="Create" asp-controller="Admin" class="box">
    <div class="field"><input id="Name" name="Name" placeholder=" " required maxlength="100"><label for="Name">Firma adı</label></div>
    <div class="field"><input id="AdminName" name="AdminName" placeholder=" " required maxlength="80"><label for="AdminName">Yönetici adı</label></div>
    <div class="field"><input id="AdminEmail" name="AdminEmail" type="email" placeholder=" " required maxlength="120"><label for="AdminEmail">Yönetici e-postası</label></div>
    <div class="field"><input id="AdminPassword" name="AdminPassword" type="password" placeholder=" " required minlength="8" autocomplete="new-password"><label for="AdminPassword">Yönetici şifresi (en az 8 karakter)</label></div>
    <div class="field"><input id="CardName" name="CardName" placeholder=" " maxlength="60"><label for="CardName">İlk kart adı (isteğe bağlı, örn. Kasa)</label></div>
    <button class="btn">Firma ekle</button>
  </form>
  <h2>Firmalar</h2>
  <div class="box">
    @if (Model.Rows.Count == 0) { <p>Henüz firma yok.</p> }
    @foreach (var b in Model.Rows) {
      <div class="row" style="flex-wrap:wrap;align-items:center">
        <div class="avatar sm">@if (!string.IsNullOrEmpty(b.LogoUrl)) { <img src="@b.LogoUrl" alt=""> } else { <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 100-8 4 4 0 000 8zm0 2c-3 0-8 1.5-8 4v2h16v-2c0-2.5-5-4-8-4z"/></svg> }</div>
        <div style="flex:1;min-width:180px"><a class="bname" href="/panel?b=@b.Id">@b.Name</a> @if (!b.Active) { <span class="chip">Pasif</span> }
          <div class="meta">@b.Cards.Count kart · @b.Feedbacks yorum · @(b.Admins.Count > 0 ? string.Join(", ", b.Admins) : "yönetici yok")</div>
          @foreach (var c in b.Cards) { <div class="meta" style="word-break:break-all">@c.Name: @Model.AppUrl/r/@c.Code</div> }</div>
        <div class="actions">
          <form method="post" asp-action="Toggle" asp-controller="Admin"><input type="hidden" name="id" value="@b.Id"><input type="hidden" name="active" value="@((!b.Active).ToString().ToLower())"><button class="btn alt sm">@(b.Active ? "Pasifleştir" : "Aktifleştir")</button></form>
          <form method="post" asp-action="Delete" asp-controller="Admin" data-confirm="Bu firma arşivlensin mi? Veriler silinmez ama giriş ve kartlar kapanır."><input type="hidden" name="id" value="@b.Id"><button class="btn alt sm" style="color:var(--err)">Sil</button></form>
        </div></div>
    }
  </div>
</div>
